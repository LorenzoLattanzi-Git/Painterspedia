<?xml version="1.0" encoding="utf-8"?>

<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    android:background="#c99157"
    >



    <RelativeLayout
        android:id="@+id/rel"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="#96613d"
        android:gravity="top"
        android:layout_alignParentTop="true"
        >

        <RelativeLayout
            android:id="@+id/rel5"
            android:layout_width="200dp"
            android:layout_height="100dp"
            android:gravity="left"
            android:background="@drawable/round_button"
            >

             <ImageView
                 android:id="@+id/logo"
                 android:layout_width="200dp"
                 android:layout_height="200dp"
                 android:layout_centerHorizontal="true"
                 android:gravity="center"
                 android:scaleType="fitXY"
                 android:src="@drawable/logoorizzontale4" />

        </RelativeLayout>

    </RelativeLayout>


    <RelativeLayout
        android:id="@+id/rel4"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:layout_centerHorizontal="true"
        android:background="@drawable/homeimage"
        android:layout_below="@+id/rel"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp"
        >

  <!--  <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:id="@+id/imageprova"
        android:src="@drawable/vincent_van_gogh"
        android:scaleType="fitXY"
        android:background="@drawable/homeimage"
        />-->

        <de.hdodenhof.circleimageview.CircleImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerHorizontal="true"
            android:id="@+id/imageprova"
            android:src="@drawable/vincent_van_gogh"
            android:background="@drawable/homeimage"
            app:civ_border_color="#9A3B3B"
            app:civ_border_width="3dp"
            />

    </RelativeLayout>



    <ImageButton
        android:id="@+id/buttonFoto"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="100dp"
        android:background="@drawable/buttonphoto"
        android:contentDescription="Photo"
        android:src="@drawable/baseline_photo_camera_24"
        android:layout_centerHorizontal="true"
        />

     <!--<ImageButton
     android:id="@+id/buttonFoto"
     android:layout_width="80dp"
     android:layout_height="80dp"
     android:layout_alignParentBottom="true"
     android:layout_marginBottom="40dp"
     android:background="@drawable/round_button"
     android:contentDescription="Photo"
     android:src="@drawable/baseline_photo_camera_24"
     android:layout_centerHorizontal="true"
     />

    <ImageButton
        android:id="@+id/popup"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="20dp"
        android:background="@drawable/round_button"
        android:contentDescription="Pop up"
        android:src="@drawable/baseline_help_24"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:layout_marginRight="20dp"

        />-->


    <ImageButton
        android:id="@+id/popup"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:layout_marginTop="20dp"
        android:background="@drawable/round_button"
        android:layout_marginRight="10dp"
        android:contentDescription="Pop up"
        android:src="@drawable/baseline_help_24" />


    <TextView
        android:id="@+id/sottotesto"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@+id/buttonFoto"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="40dp"
        android:gravity="center"
        android:layout_centerHorizontal="true"
        android:text="Fai una foto a un'opera d'arte"
        android:textSize="18sp"
        android:textStyle="bold"
        />



</RelativeLayout>

