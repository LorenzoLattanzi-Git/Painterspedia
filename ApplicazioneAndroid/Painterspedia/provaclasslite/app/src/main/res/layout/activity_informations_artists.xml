    <ImageButton
        android:id="@+id/bff"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_below="@+id/seekbar"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:layout_marginTop="14dp"
        android:layout_marginRight="70dp"
        android:layout_weight="1"
        android:background="@drawable/audiobutton"
        android:contentDescription="bff"
        android:src="@drawable/baseline_keyboard_double_arrow_right_24" />

    <ImageButton
        android:id="@+id/bbf"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_below="@+id/seekbar"
        android:layout_alignParentLeft="true"
        android:layout_centerVertical="true"
        android:layout_marginLeft="70dp"
        android:layout_marginTop="14dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="20dp"
        android:layout_weight="1"
        android:background="@drawable/audiobutton"
        android:contentDescription="bbf"
        android:src="@drawable/baseline_keyboard_double_arrow_left_24" />


    <ImageButton
        android:id="@+id/play"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_below="@+id/seekbar"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="10dp"
        android:background="@drawable/audioplaystop"
        android:contentDescription="Start"
        android:src="@drawable/baseline_play_arrow_24" />



    <ImageButton
        android:id="@+id/pause"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_below="@+id/seekbar"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="10dp"
        android:background="@drawable/audioplaystop"
        android:contentDescription="Stop"
        android:src="@drawable/baseline_pause_24"
        android:visibility="gone"
        />


    </RelativeLayout>


    <RelativeLayout
        android:id="@+id/rel3"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="#96613d"
        android:gravity="bottom"
        android:layout_alignParentBottom="true"
        >


        <ImageButton
            android:id="@+id/informazioni_artista"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_alignParentRight="true"
            android:layout_alignParentBottom="true"
            android:layout_centerVertical="true"
            android:layout_marginRight="10dp"
            android:layout_marginBottom="10dp"
            android:layout_weight="1"
            android:background="@drawable/round_button"
            android:contentDescription="Ulteriori Informazioni"
            android:src="@drawable/baseline_info_24"
            android:text=""
            android:textAllCaps="false"
            android:textSize="20sp"
            android:textStyle="bold" />


        <ImageButton
            android:id="@+id/back"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_alignParentLeft="true"
            android:layout_alignParentBottom="true"
            android:layout_centerVertical="true"
            android:layout_marginLeft="10dp"
            android:layout_marginBottom="10dp"
            android:layout_weight="1"
            android:background="@drawable/round_button"
            android:contentDescription="Back"
            android:src="@drawable/baseline_arrow_back_24"
            android:text=""
            android:textAllCaps="false"
            android:textSize="20sp"
            android:textStyle="bold" />

    </RelativeLayout>











